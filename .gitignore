# Python virtual environments
# pyvenv.cfg is the definitive venv marker; the rest are the conventional
# directory names. Bare bin/ include/ lib/ lib64/ share/ are deliberately NOT
# listed -- gitignore patterns without a slash match at every depth, so those
# would silently swallow a real bin/ or lib/ directory belonging to a tool.
# Create venvs as .venv/ (see each tool's README) and they stay ignored.
.venv/
venv/
env/
ENV/
pyvenv.cfg
pip-selfcheck.json

# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/

# Local environment / secrets
.env
*.env
!*.env.example

# Generated reports / output
reports/
*.report.json

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
