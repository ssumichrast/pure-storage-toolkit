# FlashBlade connection settings.
# Copy this file to ".env" (or pass --env-file) and fill in real values.
# CLI flags override these values; nothing overrides the CLI flags.
#
# The .env file is git-ignored so your token never gets committed.

# Management hostname or IP of the FlashBlade
FB_HOST=flashblade.example.com

# API token for authentication (Purity//FB: Settings > Users > API Tokens)
FB_API_TOKEN=T-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
